{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamFlow",
  "version": "0.1.0",
  "identifier": "app.streamflow.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "StreamFlow", "width": 900, "height": 720, "minWidth": 640, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
